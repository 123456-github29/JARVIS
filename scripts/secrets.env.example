# ─────────────────────────────────────────────────────────────────
# JARVIS secrets — copy this file to  scripts/secrets.env  and fill it in.
#   cp scripts/secrets.env.example scripts/secrets.env
# Then run:  bash scripts/push-secrets.sh
#
# secrets.env is gitignored. NEVER commit real values.
# "How to get each value" is in the comment next to it (and in SETUP.md).
# ─────────────────────────────────────────────────────────────────

# ── Supabase Edge Function secret ────────────────────────────────
# Encrypts stored Google tokens. Generate once:  openssl rand -base64 32
# Keep a copy — the phone backend will need the SAME value later.
APP_ENCRYPTION_KEY=

# ── Vercel (web app) — public values, already filled ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://iqfrjomoggddxwteuigk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1mhtWKPAexk6-ycdAuR4sg_hdil-hlj

# ── Railway (phone backend) ──────────────────────────────────────
# OpenAI: platform.openai.com → API keys → Create new secret key
OPENAI_API_KEY=

# Google Cloud → APIs & Services → Credentials → your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Playground with your client id/secret (SETUP.md Step 5) → Refresh token
GOOGLE_REFRESH_TOKEN=

# Twilio console → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1

# Your Railway domain, no protocol, e.g. jarvis-production.up.railway.app
# (Railway → Settings → Networking → Generate Domain. You'll have this after
#  the first deploy; re-run the script once you do.)
PUBLIC_HOST=
