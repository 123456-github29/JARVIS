# ── Required: OpenAI (brain + voice) ──────────────────────────────
# Get from https://platform.openai.com
OPENAI_API_KEY=sk-...

# ── Required: Google (Gmail / Drive / Calendar / Docs) ────────────
# Pick ONE of the two options below.
#
# Option A — quick testing (token expires in ~1 hour):
#   Mint from https://developers.google.com/oauthplayground with scopes:
#     gmail.modify  drive  calendar  documents
GOOGLE_ACCESS_TOKEN=ya29...
#
# Option B — production refresh flow (long-lived; used by the phone server).
#   See README for how to create these in Google Cloud Console.
#   When all three are set they take priority over GOOGLE_ACCESS_TOKEN.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...

# ── Phone line: Twilio (only needed for --serve) ──────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# Public host Twilio dials back into (no protocol), e.g. your Railway domain.
# Used to build the wss:// media-stream URL in the TwiML response.
# PUBLIC_HOST=jarvis-production.up.railway.app

# ── Optional overrides ────────────────────────────────────────────
# PORT=8080
# TIMEZONE=America/Los_Angeles
# OPENAI_TEXT_MODEL=gpt-4o
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
# OPENAI_REALTIME_VOICE=alloy
# LOG_LEVEL=info
